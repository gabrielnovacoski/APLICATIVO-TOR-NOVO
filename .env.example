# Chave de API do Google Gemini (para insights de IA)
GEMINI_API_KEY=

# Google OAuth Client ID (para autenticação com Google torpmrv@gmail.com)
# Obtenha em: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=

# URL do Webhook do Google Apps Script (para sincronização em nuvem de equipes, viaturas e afastamentos)
VITE_GOOGLE_APPS_SCRIPT_URL=
